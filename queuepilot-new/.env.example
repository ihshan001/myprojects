# ---------------------------------------------------------------------------
# QueuePilot — environment template
# Copy to .env and fill in. NEVER commit .env.
# The application must fail loudly on a missing required key — never fall back
# to a default that silently disables a security control.
# ---------------------------------------------------------------------------

APP_ENV=production            # production | staging | local
APP_DEBUG=false               # true renders stack traces — NEVER in production
APP_URL=https://queuepilot.example
APP_KEY=                      # 32 random bytes, base64 — used for encryption
APP_TIMEZONE=Asia/Colombo     # fallback only; each clinic stores its own

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DRIVER=mysql               # mysql | sqlite  (sqlite is local-dev only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuepilot
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Session & security
# ---------------------------------------------------------------------------
SESSION_NAME=qpsid
SESSION_SECURE=true           # requires HTTPS
SESSION_SAMESITE=Lax
CSRF_SECRET=                  # random; signs CSRF tokens

# Patient tracking links — the PDF specifies an 18-hour default.
TRACK_TOKEN_HOURS=18

# Login abuse protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Mail (invitations, password reset, appointment notifications)
# When no transport is configured the app shows invitation/reset links once
# on screen instead of silently failing to send them.
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=smtp           # smtp | sendmail | none
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=QueuePilot
MAIL_FROM_ADDRESS=no-reply@example.com

# ---------------------------------------------------------------------------
# SMS gateway
# ---------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=
SMS_ENDPOINT=
SMS_SENDER_ID=
SMS_API_KEY=
SMS_API_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp (optional)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_ENDPOINT=
WHATSAPP_ORGANISATION=
WHATSAPP_TOKEN=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_SLEEP_SECONDS=5
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BACKOFF=60,300,1800,7200

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
STORAGE_PATH=../storage
UPLOAD_MAX_KB=2048

# ---------------------------------------------------------------------------
# Health monitoring (feeds /admin/health — green ticks must mean something)
# ---------------------------------------------------------------------------
HEALTH_TOKEN=                 # bearer token for /api/health
BACKUP_MAX_AGE_HOURS=26
