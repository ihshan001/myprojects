# ============================================================================
#  QueuePilot — .env for XAMPP on Windows (local development only)
# ============================================================================
#  Copy this file to .env in the same folder:
#
#      copy .env.xampp.example .env
#
#  Then replace APP_KEY on the line marked below. Everything else in this file
#  is already correct for a default XAMPP install: Apache on port 80, MySQL on
#  127.0.0.1:3306, root with no password, and the app in
#  C:\xampp\htdocs\clinicqueue.
#
#  If you unzipped the folder under a different name — or anywhere other than
#  htdocs — change APP_URL to match. That is the single value most installs
#  get wrong: it must include the folder name and must NOT end with a slash.
# ============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/clinicqueue
APP_NAME=QueuePilot
APP_TIMEZONE=Asia/Colombo

# ---------------------------------------------------------------- database --
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuepilot
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------- session --
SESSION_PATH=storage/sessions

# ---------------------------------------------------------------- security --
# Generate one and paste it here:
#     C:\xampp\php\php.exe -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# An empty APP_KEY is not fatal locally (the app falls back to a key that is
# public in this repository), but the fallback is exactly why production
# refuses to boot without it. Set it now and you never think about it again.
APP_KEY=

# ------------------------------------------------------------- two-factor --
# A platform admin must enrol an authenticator before /admin opens. Keep true
# if you want to see the real behaviour; set false only while poking around on
# your own laptop, and never carry that line to a host.
SECURITY_REQUIRE_2FA_SUPER=true

# ------------------------------------------------------- mail / messaging --
# log = write to storage/logs/ instead of sending. Nothing leaves the machine,
# and you can read every message the app would have sent — including the
# welcome link and the invoice — in storage/logs/mail.log.
MAIL_TRANSPORT=log
SMS_GATEWAY=log
WHATSAPP_TRANSPORT=log

# ---------------------------------------------------------------- company --
# Invoices say "our bank details are not on this installation yet" until these
# are set. Fill them in if you want a realistic invoice; blank is fine locally.
COMPANY_BANK=
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_ACCOUNT_NO=
