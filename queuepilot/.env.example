# ============================================================================
# QueuePilot — environment
# Copy to .env and edit. Every value has a safe default in config/config.php,
# so the app boots without this file (SQLite + local sessions).
# ============================================================================

APP_ENV=production
APP_DEBUG=false
# The address the application is served at. Include the path if it is mounted in a
# subdirectory — for example http://localhost/clinicqueue when the repository sits
# in htdocs\clinicqueue. Every link, form action, redirect and asset URL is built
# from this, and the path is stripped from incoming requests before routing, so a
# wrong value here means either every route 404s or every link points outside the
# app. No trailing slash.
APP_URL=https://queues.example.lk
APP_TIMEZONE=Asia/Colombo
APP_NAME=QueuePilot

# ---------------------------------------------------------------- database --
# sqlite is the zero-setup default; mysql is the production target.
# Both run the identical hand-written SQL (database/schema/{sqlite,mysql}.sql).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuepilot
DB_USERNAME=queuepilot
DB_PASSWORD=change-me
# DB_DRIVER=sqlite
# DB_SQLITE=/var/lib/queuepilot/queuepilot.sqlite

# ----------------------------------------------------------------- session --
# Must be a directory the PHP user can write to, and must NOT be world-readable.
SESSION_PATH=storage/sessions

# ---------------------------------------------------------------- security --
# 32+ random bytes, hex. Generate with: php -r "echo bin2hex(random_bytes(32));"
#
# REQUIRED IN PRODUCTION. Without it the app falls back to a key that is
# committed to this repository and therefore public — every encrypted 2FA
# secret on the install would be readable by anyone who has seen the source.
# The app refuses to boot in production on that fallback; tools/host-drill.php
# reports it. Changing the key invalidates existing two-factor enrolments.
APP_KEY=
SESSION_LIFETIME=28800
IDLE_TIMEOUT=2700
PASSWORD_MIN=10

# -------------------------------------------------------------------- mail --
# Tells clinics they are approved, and carries the welcome link that lets the
# owner set their own password. No password itself is ever emailed.
#   none = do not send; approval says so and the link is copied by hand.
#   log  = write the message to storage/logs/ (safe default in development).
#   smtp = deliver. Socket SMTP with STARTTLS: no Composer, so it works on
#          shared hosting where nothing can be installed.
MAIL_TRANSPORT=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Google free tier: turn on 2-Step Verification, then create an App password.
# The From address must be the Gmail address itself — sending as your own
# domain through Gmail fails SPF/DMARC and lands in spam.
# Limits: ~500 recipients/day, ~100 per message. Fine to start, not to grow on.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# tls = STARTTLS on 587 (what Gmail, Brevo, Mailgun and SES all expect).
MAIL_ENCRYPTION=tls
# Test with: php tools/mail-test.php you@example.com

# ----------------------------------------------------------------- company --
# Invoices are legal documents. "Pay Rs 7,900" is not payable until it says to
# whom and where. Fill these in before the first real invoice leaves; the bank
# block below is also shown to clinics on the billing page next to every unpaid
# invoice, because bank transfer is the only way to pay.
# The company is not registered yet, so legal_name is a deliberate placeholder.
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_REG_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_EMAIL=
# Where "a clinic just applied" alerts go. Defaults to COMPANY_EMAIL if unset.
COMPANY_ALERTS_EMAIL=
COMPANY_PHONE=
COMPANY_BANK=
COMPANY_BANK_BRANCH=
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_ACCOUNT_NO=
COMPANY_BANK_SWIFT=

# ---------------------------------------------------------------- monitoring --
# Bearer token for GET /api/health. Empty closes the endpoint to everyone but a
# signed-in super admin — an open health page lists tenants and backup paths.
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Point an uptime monitor at it; only a critical fault returns 503.
MONITOR_TOKEN=

# ------------------------------------------------------------------ billing --
# Yearly plans are 20% off twelve monthly payments, derived in tools/seed.php
# rather than typed twice. Change it there and re-run the seeder.
# A verified payment clears suspension and grace and sets renews_on by cycle.

# ---------------------------------------------------------------- two-factor --
# Platform admins must enrol TOTP before they can reach any admin screen. Set
# false ONLY to recover from a lost authenticator, then set it back: the account
# that can read every clinic's records is the one worth stealing.
SECURITY_REQUIRE_2FA_SUPER=true

# ----------------------------------------------------------- notifications --
# The gateway is deliberately swappable: 'log' writes to the app log and is the
# default so a fresh install never sends a real SMS by accident.
# log | http | auto
#   log  = record the message in the app log, report it as `logged`, text nobody.
#          The safe default: a fresh install cannot message a real patient.
#   http = POST to SMS_PROVIDER_URL. Missing credentials is an error, not a
#          silent simulation, so a half-configured install fails loudly.
#   auto = http when the URL, SID and token are all present, log otherwise.
SMS_GATEWAY=log
SMS_FROM=QueuePilot
SMS_PROVIDER_URL=
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=
# text.lk SMS gateway — `POST https://app.text.lk/api/v3/sms/send`, Bearer auth.
# SMS_GATEWAY=textlk routes every outgoing SMS through text.lk (0.64 LKR each).
# Requires a text.lk account and an approved sender ID (≤11 alphanumeric).
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=
# WhatsApp Cloud API. `log` records the message and reports it as recorded,
# never as sent. `http` sends for real and fails loudly when a credential is
# missing. `auto` sends when credentials exist and logs otherwise.
WHATSAPP_TRANSPORT=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Business-initiated messages (a token call, a reminder) must use a template
# approved in Meta Business Manager. Without this, sends only work inside the
# 24-hour customer-service window and fail outside it with error 131047.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
QUEUE_MAX_RECALLS=3
TRACK_TOKEN_HOURS=18
