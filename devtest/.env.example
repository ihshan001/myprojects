# ============================================================================
# QueuePilot — environment
# Copy to .env and edit. Every value has a safe default in config/config.php,
# so the app boots without this file (SQLite + local sessions).
# ============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://queues.example.lk
APP_TIMEZONE=Asia/Colombo
APP_NAME=QueuePilot

# ---------------------------------------------------------------- database --
# sqlite is the zero-setup default; mysql is the production target.
# Both run the identical hand-written SQL (database/schema/{sqlite,mysql}.sql).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuepilot
DB_USERNAME=queuepilot
DB_PASSWORD=change-me
# DB_DRIVER=sqlite
# DB_SQLITE=/var/lib/queuepilot/queuepilot.sqlite

# ----------------------------------------------------------------- session --
# Leave UNSET for local development. The app then uses storage/sessions/<port>,
# which the bundled PHP-WASM runtime can write. Setting this to a directory that
# does not exist (or that the runtime cannot reach) makes every POST fail with a
# 419 that looks like a CSRF bug and is not one -- see docs/OPERATIONS.md.
# On a real host, point it at a private, PHP-writable directory instead:
# SESSION_PATH=/var/lib/php/sessions

# ---------------------------------------------------------------- security --
# 32+ random bytes, hex. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
SESSION_LIFETIME=28800
IDLE_TIMEOUT=2700
PASSWORD_MIN=10

# ----------------------------------------------------------- notifications --
# The gateway is deliberately swappable: 'log' writes to the app log and is the
# default so a fresh install never sends a real SMS by accident.
# log | http | auto
#   log  = record the message in the app log, report it as `logged`, text nobody.
#          The safe default: a fresh install cannot message a real patient.
#   http = POST to SMS_PROVIDER_URL. Missing credentials is an error, not a
#          silent simulation, so a half-configured install fails loudly.
#   auto = http when the URL, SID and token are all present, log otherwise.
SMS_GATEWAY=log
SMS_FROM=QueuePilot
SMS_PROVIDER_URL=
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=
# text.lk SMS gateway — `POST https://app.text.lk/api/v3/sms/send`, Bearer auth.
# SMS_GATEWAY=textlk routes every outgoing SMS through text.lk (0.64 LKR each).
# Requires a text.lk account and an approved sender ID (≤11 alphanumeric).
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=
# WhatsApp Cloud API. `log` records the message and reports it as recorded,
# never as sent. `http` sends for real and fails loudly when a credential is
# missing. `auto` sends when credentials exist and logs otherwise.
WHATSAPP_TRANSPORT=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Business-initiated messages (a token call, a reminder) must use a template
# approved in Meta Business Manager. Without this, sends only work inside the
# 24-hour customer-service window and fail outside it with error 131047.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
QUEUE_MAX_RECALLS=3
TRACK_TOKEN_HOURS=18
